# ============================================================
# MODO POR DEFECTO: SOLO FUENTES GRATUITAS (sin claves)
# ESPN y OpenLigaDB se usan automáticamente. Las variables premium
# de abajo son opcionales y, si están vacías, su adapter se omite.
# ============================================================

# --- Premium (opcional) ---
# The Odds API - https://the-odds-api.com/
# Plan gratuito: 500 créditos al mes.
THE_ODDS_API_KEY=

# SportMonks - https://www.sportmonks.com/
# El plan free cubre Premier League y Bundesliga.
SPORTMONKS_KEY=

# API-Sports - https://api-sports.io/
# La misma clave funciona para Football, Basketball, Baseball e Hockey.
APISPORTS_KEY=

# Apuestas Royal - captura automatizada con sesión iniciada.
APUESTAS_ROYAL_USER=
APUESTAS_ROYAL_PASS=
# URL verificada de la página de cuotas de Apuestas Royal.
BOOKMAKER_URL=https://app.apuestasroyal.com/
# Opcional y recomendado: sesión exportada con `npm run royal:login`.
# Es un JSON de Playwright; guárdalo como secret ROYAL_STORAGE_STATE en GitHub.
ROYAL_STORAGE_STATE=
# Opcional: URL de login y selectores.
# APUESTAS_ROYAL_LOGIN_URL=https://apuestasroyal.example/login
# ROYAL_USER_SELECTOR=input[name="username"]
# ROYAL_PASS_SELECTOR=input[type="password"]
# ROYAL_SUBMIT_SELECTOR=button[type="submit"]

# Token compartido para proteger POST /api/ingest/* y el refresco de The Analyst.
# Debe coincidir con el secret INGEST_TOKEN del workflow y del Worker.
INGEST_TOKEN=

# URL pública del sitio (sin barra final), usada por el workflow de refresco.
SITE_URL=https://betstatspro.tu-cuenta.workers.dev

# TheSportsDB (fuente gratuita de cartelera). Requiere key gratuita propia.
# La key pública "123" se descartó por HTTP 429; sin esta variable la fuente se omite.
THESPORTSDB_KEY=

# ETL API-only (scripts/etl-extract-apis.mjs)
# Usa THE_ODDS_API_KEY, SPORTMONKS_KEY, APISPORTS_KEY si están configuradas.
# Opcional: destino de ingesta curada
# ETL_INGEST_URL=https://betstatspro.tu-cuenta.workers.dev/api/ingest/curated
# Persistencia fs para /api/ingest/curated (solo local/dev; no durable en Workers)
# ENABLE_ETL_FS_PERSIST=1
