{
  "name": "betstats-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de analítica deportiva y cuotas para fútbol, básquet, béisbol y hockey.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test:dates": "node --test scripts/date-window.test.mjs scripts/purge-out-of-window.test.mjs",
    "test:model": "node --experimental-strip-types --test scripts/model-core.test.mjs scripts/model-historical.test.mjs",
    "test:fusion": "node --experimental-strip-types --test scripts/fusion-engine.test.mjs scripts/circuit-breaker.test.mjs",
    "test:etl": "node --test scripts/etl-payload.test.mjs",
    "clean:dates": "node scripts/purge-out-of-window.mjs --write",
    "capture:triunfobet": "node scripts/triunfobet-capture.mjs --write",
    "capture:royal": "node scripts/apuestas-royal-capture.mjs --write",
    "royal:login": "node scripts/royal-login-session.mjs",
    "royal:export": "node scripts/royal-export-cdp.mjs",
    "refresh:the-analyst": "node scripts/the-analyst-scrape.mjs scripts/the-analyst-payload.json 20 prediction",
    "ingest:triunfobet": "node scripts/ingest-triunfobet.mjs",
    "ingest:royal": "node scripts/ingest-apuestas-royal.mjs",
    "ingest:flashscore": "node scripts/ingest-payload.mjs",
    "etl:validate": "node scripts/validate-ingest-payload.mjs",
    "etl:apis": "node scripts/etl-extract-apis.mjs",
    "sources:check": "node scripts/validate-sources.mjs",
    "etl:report": "node scripts/validate-ingest-payload.mjs --kind curated --allow-stale data/curated/api-extract.json",
    "refresh:all": "node scripts/ingest-payload.mjs --dry-run && node scripts/ingest-triunfobet.mjs --dry-run && node scripts/ingest-apuestas-royal.mjs --dry-run",
    "backtest": "node --experimental-strip-types scripts/backtest.ts",
    "artifact:build": "node --experimental-strip-types scripts/build-model-artifact.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "postbuild:vinext": "next typegen",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.4.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "autoprefixer": "^10.4.21",
    "cf": "^1.0.0-rc.2",
    "playwright": "^1.65.1",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "^5.8.3",
    "vite": "8.3.8"
  },
  "overrides": {
    "fflate": "0.8.3",
    "postcss": "$postcss"
  },
  "type": "module"
}
