{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://betstatspro.local/schemas/ingest-payload.schema.json",
  "title": "BetStats Pro Ingest Payload",
  "type": "object",
  "required": ["target_app", "source", "sync_mode", "fecha_extraccion"],
  "properties": {
    "target_app": { "const": "BetStats Pro" },
    "source": {
      "enum": [
        "flashscore_agent",
        "triunfobet_agent",
        "apuestas_royal_agent",
        "the_analyst_agent",
        "odds_api",
        "api_sports",
        "sportmonks",
        "etl_curated"
      ]
    },
    "sync_mode": { "enum": ["enrich_or_create", "replace_window"] },
    "fecha_extraccion": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "zona_horaria": { "type": "string" },
    "total_partidos": { "type": "integer", "minimum": 0 },
    "total_cotizaciones": { "type": "integer", "minimum": 0 },
    "total_registros": { "type": "integer", "minimum": 0 },
    "partidos": { "type": "array" },
    "cotizaciones": { "type": "array" },
    "registros": { "type": "array" },
    "matches": { "type": "array" },
    "advertencias": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
